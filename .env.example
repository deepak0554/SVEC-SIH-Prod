# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# JWT_SECRET: Required in production. Used to cryptographically sign and verify student and admin tokens.
# Must be at least 16 characters and unpredictable in production environments.
JWT_SECRET=

# ADMIN_PASSCODE: Master emergency administrative passcode.
ADMIN_PASSCODE=

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP Email Server Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS Gateway Credentials (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# SMS Gateway Credentials (MSG91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=

# WhatsApp Cloud API Credentials (Meta Graph API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=

# External Relational Database (PostgreSQL / Cloud SQL / Supabase)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
